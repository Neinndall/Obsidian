@using CommunityToolkit.HighPerformance;
@using LeagueToolkit.Core.Wad;
@using LeagueToolkit.Toolkit.Ritobin;
@using Obsidian.Data.Wad;
@using System.Text.Json;
@using System.Text;
@using Obsidian.Services;
@using BlazorMonaco;
@using BlazorMonaco.Editor;
@using MonacoEditorGlobal = BlazorMonaco.Editor.Global;
@using System.Text.RegularExpressions;
@using Obsidian.Utils;

<style>
    .monaco-editor-container {
        height: 100%;
    }
</style>

<div class="@(_isEnabled ? "wad-file-preview-text" : "wad-file-preview-text-hidden")">
    <StandaloneCodeEditor @ref="_codeEditor" Id="@WadPreviewUtils.CODE_EDITOR_ID"
                          ConstructionOptions="EditorConstructionOptions"
                          OnDidInit="OnDidInit" />
</div>

@code {
    [Inject]
    public IJSRuntime Js { get; set; }

    [Inject]
    public HashtableService Hashtable { get; set; }

    [Parameter]
    public WadTreeModel WadTree { get; set; }

    private bool _isEnabled => this.WadTree.CurrentPreviewType is WadFilePreviewType.Text;

    private StandaloneCodeEditor _codeEditor = null;

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Theme = "vs-dark",
            AutomaticLayout = true,
            Value = "",
            ReadOnly = true,
            CodeLens = true,
        };
    }

    private async Task OnDidInit()
    {
        await this.Js.InvokeVoidAsync("registerRitobinLanguage");
    }

    public async Task PreviewRitobin(Stream stream)
    {
        using RitobinWriter writer =
            new(
                this.Hashtable.BinEntries,
                this.Hashtable.BinTypes,
                this.Hashtable.BinFields,
                this.Hashtable.BinHashes,
                this.Hashtable.Hashes
            );

        await this._codeEditor.SetValue(writer.WritePropertyBin(new(stream)));
        await MonacoEditorGlobal.SetModelLanguage(await this._codeEditor.GetModel(), "ritobin");
    }

    public async Task Preview(Stream stream, string language)
    {
        using StreamReader reader = new(stream);
        string rawContent = await reader.ReadToEndAsync();

        // Manejo de contenido según el tipo de lenguaje
        if (language.Equals("html", StringComparison.OrdinalIgnoreCase))
        {
            // Para HTML, mostrar el contenido tal cual
            await this._codeEditor.SetValue(rawContent);
            await MonacoEditorGlobal.SetModelLanguage(await this._codeEditor.GetModel(), "html");
        }
        else
        {
            // Para otros tipos de contenido, intenta formatear como JSON
            string formattedJson = FormatJson(rawContent);
            await this._codeEditor.SetValue(formattedJson);
            await MonacoEditorGlobal.SetModelLanguage(await this._codeEditor.GetModel(), language);
        }
    }

    private string FormatJson(string json)
    {
        try
        {
            using JsonDocument doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            // Si el contenido no es JSON válido, devuelve el contenido original
            return json; 
        }
    }

    private string ExtractJsonFromJavaScript(string jsContent)
    {
        // Aquí puedes ajustar la expresión regular para extraer JSON correctamente
        var match = Regex.Match(jsContent, @"\{.*?\}", RegexOptions.Singleline);
        return match.Success ? FormatJson(match.Value) : null;
    }

}
