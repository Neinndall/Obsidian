@using Microsoft.WindowsAPICodePack.Dialogs;
@using Obsidian.Data.Wad;
@using Obsidian.Data;
@using Obsidian.Pages;
@using Obsidian.Utils;
@using Serilog;

<div class="tree-view-item-wrapper cursor-pointer @(Item.IsSelected ? "tree-view-item-wrapper-selected" : "")"
     style="height: 30px;"
     @onclick="OnRowClick"> <!-- Asegúrate de que esta línea esté cerrada correctamente -->
    <MudMenu Dense PositionAtCurser FullWidth="false" ActivationEvent="MouseEvent.RightClick" Size="Size.Small">
        <ChildContent>
            <MudMenuItem Icon="@Icons.Material.Outlined.CopyAll" IconSize="Size.Small" IconColor="Color.Primary"
                         OnClick="@CopyPathToClipboard">
                <MudText Typo="Typo.subtitle2">Copy Path</MudText>
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.CopyAll" IconSize="Size.Small" IconColor="Color.Primary"
                         OnClick="@CopyNameToClipboard">
                <MudText Typo="Typo.subtitle2">Copy Name</MudText>
            </MudMenuItem>
            <MudDivider />
            @if (Item.Type is WadTreeItemType.File)
            {
                <MudMenuItem Icon="@CustomIcons.Material.ContentSave" IconSize="Size.Small" IconColor="Color.Primary"
                         OnClick="@Save">
                    <MudText Typo="Typo.subtitle2">Save</MudText>
                </MudMenuItem>
            }
            @if (Item.IsWadArchive)
            {
                <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconSize="Size.Small" IconColor="Color.Primary"
                         OnClick="@Delete">
                    <MudText Typo="Typo.subtitle2">Delete</MudText>
                </MudMenuItem>
            }
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Outlined.Code" IconSize="Size.Small" IconColor="Color.Primary">
                <MudTooltip Delay="150" Placement="Placement.Right" Color="Color.Dark">
                    <ChildContent>
                        <MudText Typo="Typo.subtitle2">Details</MudText>
                    </ChildContent>
                    <TooltipContent>
                        <MudStack Spacing="1" AlignItems="AlignItems.Start">
                            <MudText Typo="Typo.subtitle2">
                                @Item.Path
                            </MudText>
                            @if (Item is WadTreeFileModel file)
                            {
                                <MudText Typo="Typo.subtitle2">
                                    XXHash: @string.Format("{0:x16}", file.Chunk.PathHash)
                                </MudText>
                                <MudText Typo="Typo.subtitle2">
                                    Compressed Size: @file.Chunk.CompressedSize
                                </MudText>
                                <MudText Typo="Typo.subtitle2">
                                    Uncompressed Size: @file.Chunk.UncompressedSize
                                </MudText>
                            }
                        </MudStack>
                    </TooltipContent>
                </MudTooltip>
            </MudMenuItem>
        </ChildContent>
        <ActivatorContent>
            <table class="tree-view-item" style="height: 30px;">
                <tr @key="Item.Id">
                    @for (int i = 0; i < Item.Depth; i++)
                    {
                        <td class="tree-view-item-childrenLine"></td>
                    }
                    <td style="vertical-align: middle; width: 18px">
                        @if (Item.Type is WadTreeItemType.Directory)
                        {
                            <MudIconButton Icon="@(Item.IsExpanded ? Icons.Material.Outlined.KeyboardArrowDown : Icons.Material.Outlined.KeyboardArrowRight)"
                                       Color="Color.Inherit" Size="Size.Small"
                                       OnClick="@OnToggleExpand" />
                        }
                    </td>
                    <td style="width: 28px">
                        <MudCheckBox Dense
                                     T="bool"
                                     Checked="@IsChecked"
                                     CheckedChanged="@OnCheckedChanged"
                                     Color="Color.Primary" Size="Size.Small" />
                    </td>
                    <td style="width: 24px; text-align: left; vertical-align: middle;">
                        <div style="display: flex; align-items: center; justify-content: flex-start; height: 100%;">
                            <MudIcon Icon="@Item.GetIcon()" Size="Size.Small" Color="@((Item.IsHighlighted) ? Color.Primary : Color.Inherit)" />
                        </div>
                    </td>
                    <td class="tree-view-item-name">
                        <MudHighlighter Class="mud-primary-text" Style="background-color: transparent; font-weight: bold;"
                                        Text="@Item.Name" HighlightedText="@WadTree.Filter" />
                    </td>
                </tr>
            </table>
        </ActivatorContent>
    </MudMenu>
</div>
